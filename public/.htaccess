# 旅行分帳 v2 — 路由與安全標頭（__BASE__ 由 deploy.sh 代入）
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase __BASE__
  RewriteRule ^api/index\.php$ - [L]
  RewriteRule ^api(/.*)?$ api/index.php [L]
  RewriteRule ^t/[0-9A-Za-z]{22}/?$ index.html [L]
</IfModule>

# 只公開 index/privacy/terms、assets 與 api 入口；其他（點檔、備份、日誌、資料檔）一律拒絕
<FilesMatch "(^\.|\.(bak|log|sqlite|sqlite-wal|sqlite-shm|db|json|md|sh|env|ini|txt)$|\.bak\.)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  <If "%{REQUEST_URI} =~ m#/api(/|$)#">
    Header always set Cache-Control "no-store"
  </If>
  <If "%{REQUEST_URI} =~ m#\.html$|/$|/t/#">
    Header always set Cache-Control "no-cache"
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>
